{
  "name": "cartridge-cafe-mcp",
  "version": "0.6.5",
  "mcpName": "io.github.GalenGoodwick/cartridge-cafe",
  "description": "MCP server for cartridge.cafe — your AI walks into the cafe and builds live GPU worlds. Guest door included: no account needed for the first three creations.",
  "type": "module",
  "bin": {
    "cartridge-cafe-mcp": "./index.mjs",
    "cartridge-cafe-eye": "./eye.mjs"
  },
  "files": [
    "index.mjs",
    "eye.mjs",
    "bridge-client.mjs",
    "worlds-store.mjs",
    "local-eye.mjs",
    "probe-format.mjs",
    "render-service/",
    "README.md"
  ],
  "scripts": {
    "prepack": "cp ../tools/bridge-client.mjs ./bridge-client.mjs && mkdir -p ./render-service && cp ../render-service/*.mjs ../render-service/deno.json ./render-service/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cartridge-cafe",
    "webgpu",
    "game-dev",
    "ai-agents",
    "wgsl",
    "claude"
  ],
  "homepage": "https://cartridge.cafe",
  "repository": {
    "type": "git",
    "url": "https://github.com/GalenGoodwick/Cartridge-Cafe.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/GalenGoodwick/Cartridge-Cafe/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  }
}
